# Copy to `.env` in the docker/ directory. Never commit real credentials.

# ── Provider toggles ────────────────────────────────────────────────
# Set any of these to "off" to skip registering that provider at
# startup. Router will surface a routing_warning via cache_stats when
# a preferred provider is missing, but capability chains still work
# via any registered fallback.
FINANCE_IDX=on
FINANCE_BI=on
FINANCE_BPS=on
FINANCE_OJK=on
FINANCE_SEC=on

# ── Credentials / policy-required identifiers ──────────────────────
# BPS WebAPI key — register at https://webapi.bps.go.id/developer.
# Without a key, macro:gdp / macro:cpi / macro:inflation /
# macro:unemployment fail AUTHENTICATION_FAILED.
FINANCE_BPS_API_KEY=

# SEC EDGAR policy REQUIRES a User-Agent identifying the caller.
# Format: "Your Name your@email.com". Without it, SEC returns 403.
FINANCE_SEC_USER_AGENT=

# OJK banking-SPI snapshot — path (inside the container) to a JSON
# mirror of https://data.ojk.go.id/SJKPublic. Without it,
# macro:banking_spi returns DATA_UNAVAILABLE.
FINANCE_OJK_SPI_PATH=

# ── Optional: override the router preference table ────────────────
# Defaults to /opt/data/config/finance.routing.yaml (bundled).
# FINANCE_ROUTING_CONFIG=/opt/data/config/my.routing.yaml

# ── Data location on the host ──────────────────────────────────────
# HERMES_DATA=~/.hermes

# ── Telegram gateway ───────────────────────────────────────────────
# Bot token from @BotFather. Enables telegram_* MCP tools.
TELEGRAM_BOT_TOKEN=
# Comma-separated Telegram user IDs allowed via telegram_get_updates.
# Empty = no filter (accept everyone — NOT recommended). Get id via @userinfobot.
TELEGRAM_ALLOWED_USERS=
# Default chat for telegram_send_alert (notifications w/o known chat_id).
TELEGRAM_ALERT_CHAT_ID=
